      "id": "d9a56ec3-d446-478e-91c8-3283a76b81a6",
      "name": "AI Analysis"
    },
    {
      "parameters": {
        "jsCode": "const skills = ($json.skills || []).map(skill =>\n  String(skill).toLowerCase().trim()\n);\n\nconst requiredSkills = [\n  \"python\",\n  \"machine learning\",\n  \"numpy\",\n  \"pandas\",\n  \"scikit learn\"\n];\n\nconst matchedSkills = requiredSkills.filter(skill =>\n  skills.includes(skill)\n);\n\nconst skillScore =\n  (matchedSkills.length / requiredSkills.length) * 100;\n\nconst experienceYears =\n  Number($json.experience_years || 0);\n\nconst experienceRequirementMet =\n  experienceYears >= 1;\n\nlet ruleScore = skillScore;\n\nif (experienceRequirementMet) {\n  ruleScore += 10;\n} else {\n  ruleScore -= 20;\n}\n\nruleScore = Math.max(\n  0,\n  Math.min(100, Math.round(ruleScore))\n);\n\nreturn [\n  {\n    json: {\n      ...$json,\n      rule_score: ruleScore,\n      matched_required_skills: matchedSkills,\n      required_skill_count: requiredSkills.length,\n      matched_skill_count: matchedSkills.length,\n      minimum_experience_met: experienceRequirementMet\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        16,
        -32
      ],
      "id": "f07dc59c-230d-4567-8913-86bc61b634a7",
      "name": "Rule Score"
    },
    {
      "parameters": {
        "jsCode": "const aiScore = Number($json.score || 0);\nconst ruleScore = Number($json.rule_score || 0);\n\nconst combinedScore = Math.round(\n  (aiScore * 0.4) +\n  (ruleScore * 0.6)\n);\n\nreturn [\n  {\n    json: {\n      ...$json,\n      combined_score: combinedScore\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        144,
        -32
      ],
      "id": "abf8e0d7-6700-4166-a90c-2d6e5c56febb",
      "name": "Combined Score"
    },
